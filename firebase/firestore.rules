rules_version = '2';

// LightDesk App Store rules. Firestore is the only backend. Visitors do not sign in.
//
// Documents
//   apps/{appId}                                  app metadata and descriptors (status: pending | published | rejected | superseded)
//   apps/{appId}/versions/{version}               version records (read with the published app; moderator writes)
//   apps/{appId}/reviews/{reviewerId}             one review per browser (create-only)
//   apps/{appId}/files/{fileId}/chunks/{0000}     base64 chunks of packages, icons, screenshots
//   reports/{reportId}                            reports about published apps (moderators read)
//
// Model (no accounts)
// - Anyone may submit an app. It is created as "pending". Pending apps are unlisted:
//   they can be read only with their random id, never listed.
// - Only moderators publish, reject, or supersede apps (status changes). Moderators are
//   identified by the custom claim moderator == true, set with the Admin SDK.
// - A visitor may withdraw a submission only while it is "pending", and only with its id.
//   Ids are random 20-character values shown only to the browser that submitted the app.
//   This is a bearer capability: whoever holds the id can withdraw the pending app.
// - Published apps cannot be changed or deleted by visitors.
// - File chunks can be created only before their app document exists. Once the app
//   exists its files cannot be added to or overwritten. Chunks can be removed while the
//   app is pending, or after the app is gone (cleanup of abandoned uploads).
// - An app may only reference chunks that exist under its own id.
//
// Known limits (cannot be enforced by rules alone; see firebase/README.md)
// - Rules cannot count submissions per person or per device, read the bytes of a chunk,
//   or sum chunk sizes. The client limits uploads and reviews; App Check and quotas are the
//   real controls against floods.
// - Abandoned uploads (chunks written but no app document) remain until a clean-up job removes them.
// - Anyone holding a pending app's id can read or withdraw it.

service cloud.firestore {
  match /databases/{database}/documents {

    function isModerator() {
      return request.auth != null && request.auth.token.moderator == true;
    }

    function appPath(appId) {
      return /databases/$(database)/documents/apps/$(appId);
    }

    function appExists(appId) {
      return exists(appPath(appId));
    }

    function appStatus(appId) {
      return get(appPath(appId)).data.status;
    }

    function appIsPublished(appId) {
      return appExists(appId) && appStatus(appId) == 'published';
    }

    // Chunk n of a file under an app, checked by path.
    function chunkDoc(appId, fid, n) {
      return exists(/databases/$(database)/documents/apps/$(appId)/files/$(fid)/chunks/$(n));
    }

    // True if every chunk the descriptor claims exists (up to 16 chunks).
    function fileComplete(appId, f) {
      return chunkDoc(appId, f.id, '0000')
        && (f.chunks < 2 || chunkDoc(appId, f.id, '0001'))
        && (f.chunks < 3 || chunkDoc(appId, f.id, '0002'))
        && (f.chunks < 4 || chunkDoc(appId, f.id, '0003'))
        && (f.chunks < 5 || chunkDoc(appId, f.id, '0004'))
        && (f.chunks < 6 || chunkDoc(appId, f.id, '0005'))
        && (f.chunks < 7 || chunkDoc(appId, f.id, '0006'))
        && (f.chunks < 8 || chunkDoc(appId, f.id, '0007'))
        && (f.chunks < 9 || chunkDoc(appId, f.id, '0008'))
        && (f.chunks < 10 || chunkDoc(appId, f.id, '0009'))
        && (f.chunks < 11 || chunkDoc(appId, f.id, '0010'))
        && (f.chunks < 12 || chunkDoc(appId, f.id, '0011'))
        && (f.chunks < 13 || chunkDoc(appId, f.id, '0012'))
        && (f.chunks < 14 || chunkDoc(appId, f.id, '0013'))
        && (f.chunks < 15 || chunkDoc(appId, f.id, '0014'))
        && (f.chunks < 16 || chunkDoc(appId, f.id, '0015'));
    }

    // Descriptors { id, chunks, size, contentType }. Each kind has its own id pattern.
    function validPackageFile(f) {
      return f is map
        && f.keys().hasOnly(['id', 'chunks', 'size', 'contentType'])
        && f.id is string && f.id.matches('^pkg-[0-9A-Za-z][0-9A-Za-z.-]{0,31}-[0-9]{10,16}$')
        && f.chunks is int && f.chunks >= 1 && f.chunks <= 8
        && f.size is int && f.size > 0 && f.size <= 307200
        && f.contentType == 'text/html';
    }

    function validIconFile(f) {
      return f is map
        && f.keys().hasOnly(['id', 'chunks', 'size', 'contentType'])
        && f.id is string && f.id.matches('^icon-[0-9]{10,16}$')
        && f.chunks is int && f.chunks >= 1 && f.chunks <= 2
        && f.size is int && f.size > 0 && f.size <= 262144
        && f.contentType in ['image/png', 'image/jpeg', 'image/webp'];
    }

    function validShotFile(f) {
      return f is map
        && f.keys().hasOnly(['id', 'chunks', 'size', 'contentType'])
        && f.id is string && f.id.matches('^shot-[1-5]-[0-9]{10,16}$')
        && f.chunks is int && f.chunks >= 1 && f.chunks <= 16
        && f.size is int && f.size > 0 && f.size <= 2097152
        && f.contentType in ['image/png', 'image/jpeg', 'image/webp'];
    }

    function validShots(appId, list) {
      return list is list && list.size() <= 5
        && (list.size() < 1 || (validShotFile(list[0]) && fileComplete(appId, list[0])))
        && (list.size() < 2 || (validShotFile(list[1]) && fileComplete(appId, list[1])))
        && (list.size() < 3 || (validShotFile(list[2]) && fileComplete(appId, list[2])))
        && (list.size() < 4 || (validShotFile(list[3]) && fileComplete(appId, list[3])))
        && (list.size() < 5 || (validShotFile(list[4]) && fileComplete(appId, list[4])));
    }

    function submissionKeys() {
      return ['name', 'description', 'version', 'category', 'packageFile', 'sha256', 'size',
              'iconFile', 'screenshots', 'publisherName', 'listingKey', 'supersedes',
              'status', 'createdAt', 'updatedAt'];
    }

    // A new submission. Every file it references must already be stored under this app's id.
    function validSubmission(appId) {
      let d = request.resource.data;
      return appId.matches('^[a-z0-9]{20}$')
        && d.keys().hasOnly(submissionKeys())
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.name is string && d.name.size() > 0 && d.name.size() <= 48
        && d.version is string && d.version.matches('^[0-9A-Za-z][0-9A-Za-z.-]{0,31}$')
        && d.description is string && d.description.size() <= 500
        && d.category in ['Productivity', 'Games', 'Utilities', 'Education', 'Media', 'Developer tools', 'Other']
        && d.publisherName is string && d.publisherName.size() <= 40
        && d.listingKey is string && d.listingKey.matches('^[A-Za-z0-9_-]{6,128}$')
        && (!('supersedes' in d) || (d.supersedes is string && d.supersedes.matches('^[A-Za-z0-9_-]{6,128}$')))
        && validPackageFile(d.packageFile)
        && fileComplete(appId, d.packageFile)
        && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
        && d.size is int && d.size > 0 && d.size <= 307200
        && (!('iconFile' in d) || (validIconFile(d.iconFile) && fileComplete(appId, d.iconFile)))
        && (!('screenshots' in d) || validShots(appId, d.screenshots));
    }

    // A chunk: { i, data }. Created only while the app does not yet exist.
    function validChunk(fileId, chunkId) {
      return fileId.matches('^(pkg-[0-9A-Za-z][0-9A-Za-z.-]{0,31}-[0-9]{10,16}|icon-[0-9]{10,16}|shot-[1-5]-[0-9]{10,16})$')
        && chunkId.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['i', 'data'])
        && request.resource.data.i is int
        && request.resource.data.i >= 0 && request.resource.data.i < 16
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 300000;
    }

    match /apps/{appId} {

      // Anyone can read one app by id (pending apps are reachable only with their id).
      allow get: if true;

      // Listing is limited to published apps (and moderators), so pending apps cannot be enumerated.
      allow list: if resource.data.status == 'published' || isModerator();

      allow create: if validSubmission(appId);

      // Moderators approve, reject, or supersede. Nothing else changes.
      allow update: if isModerator()
                    && request.resource.data.status in ['pending', 'published', 'rejected', 'superseded']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time;

      // Withdraw a pending submission (by id), or a moderator removes anything.
      allow delete: if resource.data.status == 'pending' || isModerator();

      match /versions/{version} {
        allow read: if appIsPublished(appId) || isModerator();
        allow write: if isModerator();
      }

      // One review per browser, created once. Reviews cannot be edited or deleted by visitors.
      match /reviews/{reviewerId} {
        allow read: if appIsPublished(appId) || isModerator();
        allow create: if appIsPublished(appId)
                      && reviewerId.matches('^[A-Za-z0-9_-]{16,64}$')
                      && request.resource.data.keys().hasOnly(['rating', 'text', 'userName', 'createdAt'])
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                      && request.resource.data.text is string && request.resource.data.text.size() <= 500
                      && request.resource.data.userName is string && request.resource.data.userName.size() <= 40
                      && request.resource.data.createdAt == request.time;
        allow delete: if isModerator();
      }

      // Package, icon and screenshot chunks.
      match /files/{fileId}/chunks/{chunkId} {
        // Anyone holding the path can read (published apps are public; pending app
        // chunks are reachable only by id).
        allow get: if true;
        allow list: if isModerator();

        // Create only, and only before the app document exists: no adding to or
        // overwriting a submitted or published app's files.
        allow create: if !appExists(appId) && validChunk(fileId, chunkId);

        // Remove while the app is pending or already gone (abandoned or withdrawn uploads).
        // Published apps keep their files.
        allow delete: if !appExists(appId) || appStatus(appId) == 'pending' || isModerator();
      }
    }

    // Reports: visitors may report only published apps. Moderators read and resolve them.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['appId', 'reason', 'createdAt'])
                    && request.resource.data.appId is string
                    && request.resource.data.appId.matches('^[a-z0-9]{20}$')
                    && appIsPublished(request.resource.data.appId)
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isModerator();
    }

    // Everything else is closed.
  }
}
